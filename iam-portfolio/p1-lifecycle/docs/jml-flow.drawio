<mxfile host="app.diagrams.net"><diagram name="JML Flow" id="jml1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="JOINER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="150" as="geometry"/></mxCell><mxCell id="3" value="1. HR creates hire record (CSV row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="55" width="170" height="80" as="geometry"/></mxCell><mxCell id="4" value="2. Validate data + trigger (ticket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="55" width="170" height="80" as="geometry"/></mxCell><mxCell id="5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="3. IAM: create account, add to dept group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="55" width="170" height="80" as="geometry"/></mxCell><mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="4. Verify: first login, forced password change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="55" width="170" height="80" as="geometry"/></mxCell><mxCell id="9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="6" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="5. Notify manager, log evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="55" width="170" height="80" as="geometry"/></mxCell><mxCell id="11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="8" target="10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="MOVER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1100" height="150" as="geometry"/></mxCell><mxCell id="13" value="1. HR change: dept / title / manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="225" width="170" height="80" as="geometry"/></mxCell><mxCell id="14" value="2. Validate + manager approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="225" width="170" height="80" as="geometry"/></mxCell><mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="3. IAM: REMOVE old groups, THEN add new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="225" width="170" height="80" as="geometry"/></mxCell><mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="14" target="16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="4. Verify: before/after snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="225" width="170" height="80" as="geometry"/></mxCell><mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="16" target="18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="5. Update Mover Log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="225" width="170" height="80" as="geometry"/></mxCell><mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="18" target="20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="LEAVER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1100" height="150" as="geometry"/></mxCell><mxCell id="23" value="1. HR termination notice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="395" width="170" height="80" as="geometry"/></mxCell><mxCell id="24" value="2. Classify: standard vs URGENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="395" width="170" height="80" as="geometry"/></mxCell><mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="23" target="24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="3. IAM: reset pw, revoke sessions, block sign-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="395" width="170" height="80" as="geometry"/></mxCell><mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="24" target="26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="4. Remove groups/roles; keep disabled 30-90 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="395" width="170" height="80" as="geometry"/></mxCell><mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="26" target="28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="30" value="5. Verify, collect evidence, delete after retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="395" width="170" height="80" as="geometry"/></mxCell><mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="28" target="30"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>