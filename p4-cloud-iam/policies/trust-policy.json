{
    "Version":"2012-10-17",
    "Statement":[
        {
            "Sid":"AllowAssumeRoleWithMFA",
            "Effect":"Allow",
            "Principal":{"AWS":"arn:aws:iam::ACCOUNT_ID:user/dev1"},
            "Action":"sts:AssumeRole",
            "Condition":{"Bool":{"aws:MultiFactorAuthPresent":"true"}}
        }
    ]
}